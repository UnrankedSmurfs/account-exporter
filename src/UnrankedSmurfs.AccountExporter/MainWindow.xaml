<Window x:Class="UnrankedSmurfs.AccountExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UnrankedSmurfs Account Exporter"
        Height="720" Width="960" MinHeight="560" MinWidth="760"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="UnrankedSmurfs Account Exporter" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                       Text="Capture the champions, skins, chromas and profile icons on your accounts, then export a .json file you can upload to your UnrankedSmurfs listing." />
        </StackPanel>

        <!-- Client status -->
        <Border Grid.Row="1" Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ClientStatusText" Text="Checking for the League client..."
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" />
                    <TextBlock x:Name="ClientHintText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Text="Sign in to an account in the League client, then capture it here." />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CaptureButton" Content="Capture current account"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnCaptureClick" MinWidth="200" Height="38" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Privacy assurance -->
        <Border Grid.Row="2" Style="{StaticResource SurfacePanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="What this tool reads" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Region, rank, level, Blue Essence, RP, owned champions, owned skins, owned chromas and owned profile icons — nothing else. Your username, password and email are never read and never leave your PC. Nothing is uploaded anywhere; the export is a file you choose to share." />
            </StackPanel>
        </Border>

        <!-- Captured accounts -->
        <Border Grid.Row="3" Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="CapturedHeader" Text="Captured accounts (0)"
                           Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" x:Name="EmptyStateText" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           Text="No accounts captured yet.&#x0a;Sign in to an account in the League client and press &quot;Capture current account&quot;." />

                <DataGrid Grid.Row="1" x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                          BorderThickness="0" CanUserAddRows="False" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="84" />
                        <DataGridTextColumn Header="Rank" Binding="{Binding RankDisplay}" Width="110" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="64" />
                        <DataGridTextColumn Header="Blue Essence" Binding="{Binding BlueEssence, StringFormat=N0}" Width="104" />
                        <DataGridTextColumn Header="RP" Binding="{Binding RiotPoints, StringFormat=N0}" Width="84" />
                        <DataGridTextColumn Header="Champions" Binding="{Binding ChampionCount}" Width="96" />
                        <DataGridTextColumn Header="Skins" Binding="{Binding SkinCount}" Width="80" />
                        <DataGridTextColumn Header="Chromas" Binding="{Binding ChromaCount}" Width="88" />
                        <DataGridTextColumn Header="Profile icons" Binding="{Binding SummonerIconCount}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="RemoveButton" Content="Remove selected" Click="OnRemoveClick"
                    MinWidth="140" Height="38" IsEnabled="False" />

            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Margin="16,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />

            <Button Grid.Column="2" x:Name="ExportButton" Content="Export .json" Click="OnExportClick"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="160" Height="38" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>

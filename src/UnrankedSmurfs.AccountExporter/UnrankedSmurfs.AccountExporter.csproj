<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>UnrankedSmurfs.AccountExporter</RootNamespace>
    <AssemblyName>UnrankedSmurfs.AccountExporter</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Product>UnrankedSmurfs Account Exporter</Product>
    <AssemblyTitle>UnrankedSmurfs Account Exporter</AssemblyTitle>
    <Description>Exports League of Legends cosmetic inventory to a JSON file for UnrankedSmurfs listings. Never reads or writes account credentials.</Description>
    <Company>UnrankedSmurfs</Company>
    <Copyright>Copyright (c) 2023 Ja-Sa-La; Copyright (c) 2026 UnrankedSmurfs</Copyright>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/UnrankedSmurfs/account-exporter</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="5.4.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

</Project>
